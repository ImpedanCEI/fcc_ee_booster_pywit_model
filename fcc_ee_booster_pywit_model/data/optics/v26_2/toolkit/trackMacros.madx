	k = kmax;
      }
      k = k + 1;
    }
 
    X0surv = rsurv * cos((pida6D + (pada6D-pida6D)/(spda6D-1) * abs(j)) * pi);
    Y0surv = rxyda6D * rsurv * sin((pida6D + (pada6D-pida6D)/(spda6D-1) * abs(j)) * pi);
    phisurv = pida6D + (pada6D-pida6D)/(spda6D-1) * abs(j);
    FILL, table=da;
    FILL, table=da2; 
    j = j + 1;
  }

  WRITE, table=dac;
  WRITE, table=da2;
  WRITE, table=da;
  WRITE, table=da2, file=dynap_phi_nnda6D.txt;
  WRITE, table=da, file=dynap_nnda6D.txt;
}

da6Dr(ntda6Dr, rida6Dr, rada6Dr, pida6Dr, pada6Dr, srda6Dr, spda6Dr, rxyda6Dr, nnda6Dr) : macro {
