  i = 0;

  PTC_CREATE_UNIVERSE;
    PTC_CREATE_LAYOUT, MODEL=ptcmodel,NST=1,METHOD=ptcmethod,EXACT=true,RESPLIT,THIN=ptcsplit,XBEND=ptcsplit;
    PTC_ALIGN;
    PTC_SETSWITCH, debuglevel=1,maxacceleration=false,exact_mis=true,time=false,totalpath=false,fringe=true,radiation=true,stochastic=false,envelope=false, seed=1;
    PTC_TWISS, ICASE=6, CLOSED_ORBIT, NO=2, RMATRIX;
    j = 0;
    while (j < spda6Dr) {	
      k = j + 1;
      EXEC, wmacro(dac,RSURV,$k);
      rida6Dr = val;
      rada6Dr = rida6Dr + rostep;
      X0 := (rida6Dr + (rada6Dr-rida6Dr)/(srda6Dr-1) * abs(i)) * cos((pida6Dr + (pada6Dr-pida6Dr)/(spda6Dr-1) * abs(j)) * pi);
      Y0 := rxyda6Dr * (rida6Dr + (rada6Dr-rida6Dr)/(srda6Dr-1) * abs(i)) * sin((pida6Dr + (pada6Dr-pida6Dr)/(spda6Dr-1) * abs(j)) * pi);
      i = 0;
      while (i < srda6Dr) {
	PTC_START, X=X0, PX=0.0, Y=Y0, PY=0.0, T=0.0, PT=0.0;
	i = i + 1;
      }
      j = j + 1;
    }
    PTC_TRACK, ICASE=6, CLOSED_ORBIT, RADIATION, TURNS=ntda6Dr;
    PTC_TRACK_END;
  PTC_END;

  j = 0;
  while (j < spda6Dr) {
    m = j + 1;
    EXEC, wmacro(dac,RSURV,$m);
    rida6Dr = val;
    rada6Dr = rida6Dr + rostep;
    rsurv = val;
    kmin = spda6Dr * srda6Dr + j * srda6Dr + 1;
    kmax = spda6Dr * srda6Dr + (j+1) * srda6Dr + 1;

    k = kmin;
    while(k < kmax) {
      EXEC, wmacro(tracksumm,turn,$k);
      if (val == ntda6Dr) {
	rsurv = rida6Dr + (rada6Dr-rida6Dr)/(srda6Dr-1) * (k-kmin);
      }
      if (val <> ntda6Dr) {
	k = kmax;
      }
      k = k + 1;
    }
 
    X0surv = rsurv * cos((pida6Dr + (pada6Dr-pida6Dr)/(spda6Dr-1) * abs(j)) * pi);
    Y0surv = rxyda6Dr * rsurv * sin((pida6Dr + (pada6Dr-pida6Dr)/(spda6Dr-1) * abs(j)) * pi);
    phisurv = pida6Dr + (pada6Dr-pida6Dr)/(spda6Dr-1) * abs(j);
    FILL, table=da;
    FILL, table=da2; 
    j = j + 1;
  }

  WRITE, table=dac;
  WRITE, table=da2;
  WRITE, table=da;
  WRITE, table=da2, file=dynap_phi_nnda6Dr.txt;
  WRITE, table=da, file=dynap_nnda6Dr.txt;
}

da6Dnr(ntda6Dn, rida6Dn, rada6Dn, pida6Dn, pada6Dn, srda6Dn, spda6Dn, rxyda6Dn, nnda6Dn) : macro {
  CREATE, table=dac, column=phisurv,rsurv;
  CREATE, table=da2, column=phisurv,rsurv;
  CREATE, table=da, column=X0surv, Y0surv;
  rsurv = 0;
  phisurv = 0;
  j = 0;
  i = 0;
  X0 := (rida6Dn + (rada6Dn-rida6Dn)/(srda6Dn-1) * abs(i)) * cos((pida6Dn + (pada6Dn-pida6Dn)/(spda6Dn-1) * abs(j)) * pi);
  Y0 := rxyda6Dn * (rida6Dn + (rada6Dn-rida6Dn)/(srda6Dn-1) * abs(i)) * sin((pida6Dn + (pada6Dn-pida6Dn)/(spda6Dn-1) * abs(j)) * pi);

  PRINT, text="******/////////******";
  PRINT, text="coarse scan";
  PRINT, text="******/////////******";
 
  PTC_CREATE_UNIVERSE;
    PTC_CREATE_LAYOUT, MODEL=ptcmodel,NST=1,METHOD=ptcmethod,EXACT=true,RESPLIT,THIN=ptcsplit,XBEND=ptcsplit;
    PTC_ALIGN;
    PTC_SETSWITCH, debuglevel=1,maxacceleration=false,exact_mis=true,time=true,totalpath=false,fringe=true,radiation=false,stochastic=false,envelope=false, seed=1;
    j = 0;
    while (j < spda6Dn) {	
      i = 0;
      while (i < srda6Dn) {
	PTC_START, X=X0, PX=0.0, Y=Y0, PY=0.0, T=0.0, PT=0.0;
	i = i + 1;
      }
      j = j + 1;
    }
    PTC_TRACK, ICASE=6, CLOSED_ORBIT,TURNS=ntda6Dn;
    PTC_TRACK_END;
  PTC_END;

  j = 0;
  while (j < spda6Dn) {
    kmin = spda6Dn * srda6Dn + j * srda6Dn + 1;
    kmax = spda6Dn * srda6Dn + (j+1) * srda6Dn + 1;
    k = kmin;
    while(k < kmax) {
      EXEC, wmacro(tracksumm,turn,$k);
      if (val == ntda6Dn) {
	rsurv = rida6Dn + (rada6Dn-rida6Dn)/(srda6Dn-1) * (k-kmin);
      }
      if (val <> ntda6Dn) {
	k = kmax;
      }

      k = k + 1;
    }

    phisurv = pida6Dn + (pada6Dn-pida6Dn)/(spda6Dn-1) * abs(j);
    FILL, table=dac;
    j = j + 1;
  } 

  WRITE, table=dac;

  PRINT, text="doing fine scan now...";

  rio = rida6Dn;
  rostep = (rada6Dn-rida6Dn)/(srda6Dn-1);
  j = 0;
  i = 0;
  X0 := (rida6Dn + (rada6Dn-rida6Dn)/(srda6Dn-1) * abs(i)) * cos((pida6Dn + (pada6Dn-pida6Dn)/(spda6Dn-1) * abs(j)) * pi);
  Y0 := rxyda6Dn * (rida6Dn + (rada6Dn-rida6Dn)/(srda6Dn-1) * abs(i)) * sin((pida6Dn + (pada6Dn-pida6Dn)/(spda6Dn-1) * abs(j)) * pi);

  PTC_CREATE_UNIVERSE;
    PTC_CREATE_LAYOUT, MODEL=ptcmodel,NST=1,METHOD=ptcmethod,EXACT=true,RESPLIT,THIN=ptcsplit,XBEND=ptcsplit;
    PTC_ALIGN;
    PTC_SETSWITCH, debuglevel=1,maxacceleration=false,exact_mis=true,time=true,totalpath=false,fringe=true,radiation=false,stochastic=false,envelope=false, seed=1;
    j = 0;
    while (j < spda6Dn) {	
      k = j + 1;
      EXEC, wmacro(dac,RSURV,$k);
      rida6Dn = val;
      rada6Dn = rida6Dn + rostep;
      i = 0;
      while (i < srda6Dn) {
	PTC_START, X=X0, PX=0.0, Y=Y0, PY=0.0, T=0.0, PT=0.0;
	i = i + 1;
      }
      j = j + 1;
    }
    PTC_TRACK, ICASE=6, CLOSED_ORBIT, TURNS=ntda6Dn;
    PTC_TRACK_END;
  PTC_END;
  j = 0;
  while (j < spda6Dn) {
    m = j + 1;
    EXEC, wmacro(dac,RSURV,$m);
    rida6Dn = val;

    rada6Dn = rida6Dn + rostep;

    kmin = spda6Dn * srda6Dn + j * srda6Dn + 1;
    kmax = spda6Dn * srda6Dn + (j+1) * srda6Dn + 1;

    k = kmin;
    while(k < kmax) {
      EXEC, wmacro(tracksumm,turn,$k);
      if (val == ntda6Dn) {
	rsurv = rida6Dn + (rada6Dn-rida6Dn)/(srda6Dn-1) * (k-kmin);
      }
      if (val <> ntda6Dn) {
	k = kmax;
      }
      k = k + 1;
    }
 
    X0surv = rsurv * cos((pida6Dn + (pada6Dn-pida6Dn)/(spda6Dn-1) * abs(j)) * pi);
    Y0surv = rxyda6Dn * rsurv * sin((pida6Dn + (pada6Dn-pida6Dn)/(spda6Dn-1) * abs(j)) * pi);
    phisurv = pida6Dn + (pada6Dn-pida6Dn)/(spda6Dn-1) * abs(j);
    FILL, table=da;
    FILL, table=da2; 
    j = j + 1;
  }
  WRITE, table=dac;
  WRITE, table=da2;
  WRITE, table=da;
  WRITE, table=da2, file=dynap_phi_nnda6Dn.txt;
  WRITE, table=da, file=dynap_nnda6Dn.txt;
}

twissptc: macro {
  PTC_CREATE_UNIVERSE;
    PTC_CREATE_LAYOUT, MODEL=ptcmodel,NST=1,METHOD=ptcmethod,EXACT=true,RESPLIT,THIN=ptcsplit,XBEND=ptcsplit;
    PTC_ALIGN;
    PTC_SETSWITCH, debuglevel=1,maxacceleration=false,exact_mis=true,time=true,totalpath=false,fringe=true,radiation=true,stochastic=true,envelope=true, seed=1;
    PTC_TWISS, ICASE=6, CLOSED_ORBIT, NO=2, RMATRIX;
  PTC_END;
  qx0 = table(ptc_twiss_summary,q1,1);
  qy0 = table(ptc_twiss_summary,q2,1);
}
