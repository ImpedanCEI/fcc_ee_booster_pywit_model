	k = kmax;
      }   
      k = k + 1;
    }
 
    dsurv = delta;
    FILL, table=mac;
    j = j + 1;
  }

  WRITE, table=mac;

  PRINT, text="doing fine scan now...";

  xmino = xima6Dr;
  xostep = (xama6Dr-xima6Dr)/(nxma6Dr-1);

  PTC_CREATE_UNIVERSE;
    PTC_CREATE_LAYOUT, MODEL=ptcmodel,NST=1,METHOD=ptcmethod,EXACT=true,RESPLIT,THIN=ptcsplit,XBEND=ptcsplit;
    PTC_ALIGN;
    PTC_SETSWITCH, debuglevel=1,maxacceleration=false,exact_mis=true,time=false,totalpath=false,fringe=true,radiation=true,stochastic=false,envelope=false, seed=1;
    PTC_TWISS, ICASE=6, CLOSED_ORBIT, NO=2, RMATRIX;
    j = 0;
    while (j < ndma6Dr) {	
      k = j + 1;
      EXEC, wmacro(mac,XSURV,$k);
      xima6Dr = val;
      xama6Dr = xima6Dr + xostep;
      X0 := xima6Dr + abs(i) * (xama6Dr-xima6Dr)/(nxma6Dr-1);
      delta := dima6Dr + abs(j) * (dama6Dr-dima6Dr)/(ndma6Dr-1);
      i = 0;
      while (i < nxma6Dr) {
	PTC_START, X=X0, PX=0.0, Y=0.0, PY=0.0, T=0.0, PT=delta;
	i = i + 1;
      }
      j = j + 1;
    }
    PTC_TRACK, ICASE=6, CLOSED_ORBIT, RADIATION, TURNS=ntma6Dr;
    PTC_TRACK_END;
  PTC_END;
 
  j = 0;
  while (j < ndma6Dr) {
    m = j + 1;
    EXEC, wmacro(mac, XSURV, $m);
    xsurv = val;
    xima6Dr = val;
    xama6Dr = xima6Dr + xostep;
    kmin = ndma6Dr * nxma6Dr + j * nxma6Dr + 1;
    kmax = ndma6Dr * nxma6Dr + (j+1) * nxma6Dr + 1;
    k = kmin;
    while(k < kmax) {
      EXEC, wmacro(tracksumm,turn,$k);
      if (val == ntma6Dr) {
	xsurv = xima6Dr + (xama6Dr-xima6Dr)/(nxma6Dr-1) * (k-kmin);
      }
      if (val <> ntma6Dr) {
	k = kmax;
      }   
      k = k + 1;
    }
 
    x0surv = xsurv;
    d0surv = delta;

    FILL, table=ma;
  
    j = j + 1;
  }

  WRITE, table=mac;
  WRITE, table=ma;
  WRITE, table=ma, file=maper_nnma6Dr.txt;
}

ma6Dnr(ntma6Dnr, xima6Dnr, xama6Dnr, nxma6Dnr, dima6Dnr, dama6Dnr, ndma6Dnr, nnma6Dnr) : macro {
  CREATE, table=dac, column=xsurv,dsurv;
  CREATE, table=da, column=X0surv, d0surv;
  // first coarse scan:

  xsurv = 0;
  dsurv = 0;

  X0 := xima6Dnr + abs(i) * (xama6Dnr-xima6Dnr)/nxma6Dnr;
  delta := dima6Dnr + abs(j) * (dama6Dnr-dima6Dnr)/ndma6Dnr;

  j = 0;
  while (j < ndma6Dnr+1) {	
    xsurv = 0.0;
    PTC_CREATE_UNIVERSE;
      PTC_CREATE_LAYOUT, MODEL=ptcmodel,NST=1,METHOD=ptcmethod,EXACT=true,RESPLIT,THIN=ptcsplit,XBEND=ptcsplit;
      PTC_ALIGN;
      PTC_SETSWITCH, debuglevel=1,maxacceleration=false,exact_mis=true,time=true,totalpath=false,fringe=true,radiation=false,stochastic=false,envelope=false;
      i = 1;
      while (i < nxma6Dnr+1) {
	PTC_START, X=X0, PX=0.0, Y=0.0, PY=0.0, T=0.0, PT=delta;
	i = i + 1;
      }
      PRINT, text="******/////////******";
      PRINTF, text="coarse scan: %g/%g", value=j, ndma6Dnr;
      PRINT, text="******/////////******";
      PTC_TRACK, ICASE=6, CLOSED_ORBIT, TURNS=ntma6Dnr;
      PTC_TRACK_END;
 
      k = nxma6Dnr + 1;
      while(k < 2*nxma6Dnr+1) {
	EXEC, wmacro(tracksumm,turn,$k);
	if (val == ntma6Dnr) {
	  xsurv = xima6Dnr + (xama6Dnr-xima6Dnr)/nxma6Dnr * (k-nxma6Dnr);
	}   
	if (val <> ntma6Dnr) {
	  k = 2 * nxma6Dnr;
	}  
	k = k + 1;
      }
 
    PTC_END;
 
    dsurv = delta;
    FILL, table = dac;
    j = j + 1;
  }

  WRITE, table=dac;

  PRINT, text="doing fine scan now...";

  xmino = xima6Dnr;
  xostep = (xama6Dnr-xima6Dnr)/nxma6Dnr;

  j = 0;
  while (j < ndma6Dnr+1) {	
    k = j + 1;
    EXEC, wmacro(dac,XSURV,$k);
    xsurv = val;
    xima6Dnr = val;

    xama6Dnr = xima6Dnr + xostep;
  
    X0 := xima6Dnr + abs(i) * (xama6Dnr-xima6Dnr)/nxma6Dnr;
    delta := dima6Dnr + abs(j) * (dama6Dnr-dima6Dnr)/ndma6Dnr;

    PTC_CREATE_UNIVERSE;
      PTC_CREATE_LAYOUT, MODEL=ptcmodel,NST=1,METHOD=ptcmethod,EXACT=true,RESPLIT,THIN=ptcsplit,XBEND=ptcsplit;
      PTC_ALIGN;
      PTC_SETSWITCH, debuglevel=1,maxacceleration=false,exact_mis=true,time=true,totalpath=false,fringe=true,radiation=false,stochastic=false,envelope=false;
      i = 1;
      while (i < nxma6Dnr+1) {
	PTC_START, X=X0, PX=0.0, Y=0.0, PY=0.0, T=0.0, PT=delta;
	i = i + 1;
      }
      PRINT, text="******/////////******";
      PRINTF, text="coarse scan: %g/%g", value=j, ndma6Dnr;
      PRINT, text="******/////////******";
      PTC_TRACK, ICASE=6, CLOSED_ORBIT, TURNS=ntma6Dnr;
      PTC_TRACK_END;
 
      k = nxma6Dnr + 1;
      while(k < 2*nxma6Dnr+1) {
	EXEC, wmacro(tracksumm,turn,$k);
	if (val == ntma6Dnr) {
	  xsurv = xima6Dnr + (xama6Dnr-xima6Dnr)/nxma6Dnr * (k-nxma6Dnr);
	}
	if (val <> ntma6Dnr) {
	  k = 2 * nxma6Dnr;
	}  
	k = k + 1;
      }
 
      X0surv = xsurv;
      d0surv = delta;
    PTC_END;

    FILL, table=da;
  
    j = j + 1;
  }

  WRITE, table=dac;
  WRITE, table=da;
  WRITE, table=da, file=ma_nnma6Dnr.txt;

}

dafma(ntdaf, sxdaf, sydaf, nxdaf, nydaf, nsdaf, i0daf, i1daf, j0daf, j1daf, nndaf) : macro {
  PTC_CREATE_UNIVERSE;
    PTC_CREATE_LAYOUT, MODEL=ptcmodel,NST=1,METHOD=ptcmethod,EXACT=true,RESPLIT,THIN=ptcsplit,XBEND=ptcsplit;
    PTC_ALIGN;
    PTC_SETSWITCH, debuglevel=1,maxacceleration=false,exact_mis=true,time=true,totalpath=false,fringe=true,radiation=false,stochastic=false,envelope=false;
    i = 0;
    j = 0;
    X0 := sxdaf * nxdaf * sqrt(abs(i)/nsdaf);
    Y0 := sydaf * nydaf * sqrt(abs(j)/nsdaf);
    i = i0daf;
    while (i < i1daf+1) {
      j = j0daf;
      while (j < j1daf+1) {
	PTC_START, X=X0+1.0E-9, PX=0.0, Y=Y0+1.0E-9, PY=0.0, T=0.0, PT=0.0;
	j = j + 1;
      }
      i = i + 1;
    }

    PTC_TRACK, ICASE=4, CLOSED_ORBIT, TURNS=ntdaf, DUMP, ONETABLE, FILE=nndaf;
    PTC_TRACK_END;
  PTC_END;
}

mafma(ntmaf, sxmaf, nxmaf, dimaf, damaf, nsmaf, i0maf, i1maf, j0maf, j1maf, nnmaf) : macro {
  PTC_CREATE_UNIVERSE;
    PTC_CREATE_LAYOUT, MODEL=ptcmodel,NST=1,METHOD=ptcmethod,EXACT=true,RESPLIT,THIN=ptcsplit,XBEND=ptcsplit;
    PTC_ALIGN;
    PTC_SETSWITCH, debuglevel=1,maxacceleration=false,exact_mis=true,time=true,totalpath=false,fringe=true,radiation=false,stochastic=false,envelope=false;
    i = 0;
    j = 0;
    X0 := sxmaf * nxmaf * abs(i)/nsmaf;
    delta:=dimaf + abs(j) * (damaf-dimaf)/nsmaf;

    i = i0maf;
    while (i < i1maf+1) {
      j = j0maf;
      while (j < j1maf+1) {
	PTC_START, X=X0+1.0E-9, PX=0.0, Y=1.0E-9, PY=0.0, T=0.0, PT=delta;
	j = j + 1;
      }
      i = i + 1;
    }

    PTC_TRACK, ICASE=5, CLOSED_ORBIT, TURNS=ntmaf, DUMP, ONETABLE, FILE=nnmaf;
    PTC_TRACK_END;
  PTC_END;
}


da4D(ntda4D, rida4D, rada4D, pida4D, pada4D, srda4D, spda4D, rxyda4D, nnda4D) : macro {
  CREATE, table=dac, column=phisurv,rsurv;
  CREATE, table=da2, column=phisurv,rsurv;
  CREATE, table=da, column=X0surv, Y0surv;
  rsurv = 0;
  phisurv = 0;
  j = 0;
  i = 0;
  X0 := (rida4D + (rada4D-rida4D)/(srda4D-1) * abs(i)) * cos((pida4D + (pada4D-pida4D)/(spda4D-1) * abs(j)) * pi);
  Y0 := rxyda4D * (rida4D + (rada4D-rida4D)/(srda4D-1) * abs(i)) * sin((pida4D + (pada4D-pida4D)/(spda4D-1) * abs(j)) * pi);

  PRINT, text="******/////////******";
  PRINT, text="coarse scan";
  PRINT, text="******/////////******";
 
  PTC_CREATE_UNIVERSE;
    PTC_CREATE_LAYOUT, MODEL=ptcmodel,NST=1,METHOD=ptcmethod,EXACT=true,RESPLIT,THIN=ptcsplit,XBEND=ptcsplit;
    PTC_ALIGN;
    PTC_SETSWITCH, debuglevel=1,maxacceleration=false,exact_mis=true,time=true,totalpath=false,fringe=true,radiation=false,stochastic=false,envelope=false, seed=1;
    j = 0;
    while (j < spda4D) {	
      i = 0;
      while (i < srda4D) {
	PTC_START, X=X0, PX=0.0, Y=Y0, PY=0.0, T=0.0, PT=0.0;
	i = i + 1;
      }
      j = j + 1;
    }
    PTC_TRACK, ICASE=4, CLOSED_ORBIT,TURNS=ntda4D;
    PTC_TRACK_END;
  PTC_END;

  j = 0;
  while (j < spda4D) {
    rsurv = 0.0;
    kmin = spda4D * srda4D + j * srda4D + 1;
    kmax = spda4D * srda4D + (j+1) * srda4D + 1;
    k = kmin;
    while(k < kmax) {
      EXEC, wmacro(tracksumm,turn,$k);
      if (val == ntda4D) {
	rsurv = rida4D + (rada4D-rida4D)/(srda4D-1) * (k-kmin);
      }
      if (val <> ntda4D) {
	k = kmax;
      }
      k = k + 1;
    }

    phisurv = pida4D + (pada4D-pida4D)/(spda4D-1) * abs(j);
    FILL, table=dac;
    j = j + 1;
  } 

  WRITE, table=dac;
  PRINT, text="doing fine scan now...";

  rio = rida4D;
  rostep = (rada4D-rida4D)/(srda4D-1);
  j = 0;
  i = 0;
  X0 := (rida4D + (rada4D-rida4D)/(srda4D-1) * abs(i)) * cos((pida4D + (pada4D-pida4D)/(spda4D-1) * abs(j)) * pi);
  Y0 := rxyda4D * (rida4D + (rada4D-rida4D)/(srda4D-1) * abs(i)) * sin((pida4D + (pada4D-pida4D)/(spda4D-1) * abs(j)) * pi);

  PTC_CREATE_UNIVERSE;
    PTC_CREATE_LAYOUT, MODEL=ptcmodel,NST=1,METHOD=ptcmethod,EXACT=true,RESPLIT,THIN=ptcsplit,XBEND=ptcsplit;
    PTC_ALIGN;
    PTC_SETSWITCH, debuglevel=1,maxacceleration=false,exact_mis=true,time=true,totalpath=false,fringe=true,radiation=false,stochastic=false,envelope=false, seed=1;
    j = 0;
    while (j < spda4D) {	
      k = j + 1;
      EXEC, wmacro(dac,RSURV,$k);
      rsurv = val;
      rida4D = val;
      rada4D = rida4D + rostep;

      i = 0;
      while (i < srda4D) {
	PTC_START, X=X0, PX=0.0, Y=Y0, PY=0.0, T=0.0, PT=0.0;
	i = i + 1;
      }
      j = j + 1;
    }
    PTC_TRACK, ICASE=4, CLOSED_ORBIT, TURNS=ntda4D;
    PTC_TRACK_END;
  PTC_END;
  j = 0;
  while (j < spda4D) {
    m = j + 1;
    EXEC, wmacro(dac,RSURV,$m);
    rida4D = val;
    rada4D = rida4D + rostep;

    kmin = spda4D * srda4D + j * srda4D + 1;
    kmax = spda4D * srda4D + (j+1) * srda4D + 1;

    k = kmin;
    while(k < kmax) {
      EXEC, wmacro(tracksumm,turn,$k);
      if (val == ntda4D) {
	rsurv = rida4D + (rada4D-rida4D)/(srda4D-1) * (k-kmin);
      }
      if (val <> ntda4D) {
	k = kmax;
      }
      k = k + 1;
    }
    X0surv = rsurv * cos((pida4D + (pada4D-pida4D)/(spda4D-1) * abs(j)) * pi);
    Y0surv = rxyda4D * rsurv * sin((pida4D + (pada4D-pida4D)/(spda4D-1) * abs(j)) * pi);
    phisurv = pida4D + (pada4D-pida4D)/(spda4D-1) * abs(j);
    FILL, table=da;
    FILL, table=da2; 
    j = j + 1;
  }
  WRITE, table=dac;
  WRITE, table=da2;
  WRITE, table=da;
  WRITE, table=da2, file=dynap_phi_nnda4D.txt;
  WRITE, table=da, file=dynap_nnda4D.txt;
}

sP6D(ntsP6D, x0sP6D, px0sP6D, y0sP6D, py0sP6D, t0sP6D, pt0sP6D, nnsP6D) : macro {
