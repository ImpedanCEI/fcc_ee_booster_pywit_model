      if (val == ntda6D) {
	rsurv = rida6D + (rada6D-rida6D)/(srda6D-1) * (k-kmin);
      }
      if (val <> ntda6D) {
	k = kmax;
      }
      k = k + 1;
    }

    phisurv = pida6D + (pada6D-pida6D)/(spda6D-1) * abs(j);
    FILL, table=dac;
    j = j + 1;
  } 

  WRITE, table=dac;
  PRINT, text="doing fine scan now...";

  rio = rida6D;
  rostep = (rada6D-rida6D)/(srda6D-1);
  j = 0;
  i = 0;

  PTC_CREATE_UNIVERSE;
    PTC_CREATE_LAYOUT, MODEL=ptcmodel,NST=1,METHOD=ptcmethod,EXACT=true,RESPLIT,THIN=ptcsplit,XBEND=ptcsplit;
    PTC_ALIGN;
    PTC_SETSWITCH, debuglevel=1,maxacceleration=false,exact_mis=true,time=false,totalpath=false,fringe=true,radiation=true,stochastic=true,envelope=true, seed=1;
    PTC_TWISS, ICASE=6, CLOSED_ORBIT, NO=2, RMATRIX;
    j = 0;
    while (j < spda6D) {	
      k = j + 1;
      EXEC, wmacro(dac,RSURV,$k);
      rida6D = val;
      rada6D = rida6D + rostep;
      X0 := (rida6D + (rada6D-rida6D)/(srda6D-1) * abs(i)) * cos((pida6D + (pada6D-pida6D)/(spda6D-1) * abs(j)) * pi);
      Y0 := rxyda6D * (rida6D + (rada6D-rida6D)/(srda6D-1) * abs(i)) * sin((pida6D + (pada6D-pida6D)/(spda6D-1) * abs(j)) * pi);
      i = 0;
      while (i < srda6D) {
	PTC_START, X=X0, PX=0.0, Y=Y0, PY=0.0, T=0.0, PT=0.0;
	i = i + 1;
      }
      j = j + 1;
    }
    PTC_TRACK, ICASE=6, CLOSED_ORBIT, RADIATION, TURNS=ntda6D;
    PTC_TRACK_END;
  PTC_END;
  j = 0;
  while (j < spda6D) {
    m = j + 1;
    EXEC, wmacro(dac,RSURV,$m);
    rida6D = val;
    rada6D = rida6D + rostep;
    rsurv = val;
    kmin = spda6D * srda6D + j * srda6D + 1;
    kmax = spda6D * srda6D + (j+1) * srda6D + 1;

    k = kmin;
    while(k < kmax) {
      EXEC, wmacro(tracksumm,turn,$k);
      if (val == ntda6D) {
	rsurv = rida6D + (rada6D-rida6D)/(srda6D-1) * (k-kmin);
