sda6D(ntsda6D, xisda6D, xasda6D, yisda6D, yasda6D, sxsda6D, sysda6D, nnsda6D) : macro {
  i = 0;
  j = 0;
  X0 := xisda6D + (xasda6D-xisda6D)/sxsda6D * i;
  Y0 := yisda6D + (yasda6D-yisda6D)/sysda6D * j;

  PTC_CREATE_UNIVERSE;
    PTC_CREATE_LAYOUT, MODEL=ptcmodel,NST=1,METHOD=ptcmethod,EXACT=true,RESPLIT,THIN=ptcsplit,XBEND=ptcsplit;
    PTC_ALIGN;
    PTC_SETSWITCH, debuglevel=1,maxacceleration=false,exact_mis=true,time=true,totalpath=false,fringe=false,radiation=true,stochastic=false,envelope=false, seed=1;
    PTC_TWISS, ICASE=6, CLOSED_ORBIT, NO=2, RMATRIX, t=0.7;
    i = 0;
    while (i < spda6D+1) {	

      j = 0;
      while (j < srda6D+1) {
	PTC_START, X=X0, PX=0.0, Y=Y0, PY=0.0, T=0.0, PT=0.0;
	j = j + 1;
      }
      i = i + 1;
    }
    PTC_TRACK, ICASE=6, CLOSED_ORBIT, RADIATION,TURNS=ntsda6D, onetable, file=nnsda6D;
    PTC_TRACK_END;
  PTC_END;
}

da6D(ntda6D, rida6D, rada6D, pida6D, pada6D, srda6D, spda6D, rxyda6D, nnda6D) : macro {
