// PTC Tracking Macros
// -> a set of macros for tracking dynamic and momentum aperture in MADX-PTC:
// *************************************
// * Feb 2018, ttydecks CERN BE-OP-LHC *
// *************************************
//
// ** ALWAYS BE AWARE THAT WHEN CALLING MACROS WITH NEGATIVE NUMBERS THEY FAIL!!! ***
// --> WORKAROUND:
//     foo = -5.0;
//     bar = -2.0;
//     EXEC, somemacro(foo, bar);
//
// -------------------------------------------------------------------- 
// CONTENT:
//    * helpTM <-- display help, usage: EXEC, helpTM;
//    * manglePTC
//    * sP6D
//    * sP6Dnr
//    * sP5D
//    * sP4D
//    * da6D
//    * da6Dr
//    * da6Dnr
//    * dafma
//    * da4D
//    * ma5D
//    * ma6D
//    * ma6Dr
//    * ma6Dnr
//    * mafma
//    * sda6D
//    * tw6D
//    * tw6Dnr
//    * tw4D
//    * tw5D
//    * wmacro
//
// -------------------------------------------------------------------- 

// helpTM(): display documentation.

  // usage:
  // EXEC, helpTM;

// -------------------------------------------------------------------- 

// manglePTC(): change PTC default switches. Expert use!! 

  // changes the default ptc layout settings. The default values for parameters are:
  // PTC_CREATE_LAYOUT, MODEL=3,NST=3,METHOD=6,CLOSED_LAYOUT=true;

  // usage:
  // EXEC, manglePTC(newmodel, newsplit, newmethod);
  // newmodel = new model to use (1, 2, or 3) (default 2)
  // newsplit = set the splitting parameter depending on strength of magnet (default 0.001)
  // newmethod = new method for integration to use (2, 4, or 6) (default 2)
// -------------------------------------------------------------------- 

// tw6D(): Run ptc_twiss incl. radiation effects (damping + quantum excitation).
  
  // Closed orbit will be searched. 
  // usage:
  // EXEC, tw6D(no,name);
  // where:
  // no = order of computation
  // name = nametag for the output table (f.i. an error seed)

// -------------------------------------------------------------------- 

// tw6Dnr(): run ptc_twiss without radiation effects.
  
  // Closed orbit will be searched. 
  // usage:
  // EXEC, tw6Dnr(no,name);
  // where:
  // no = order of computation
  // name = nametag for the output table (f.i. an error seed)

// -------------------------------------------------------------------- 
// tw5D(): run ptc_twiss with momentum deviation.
  
  // Closed orbit will be searched. 
  // usage:
  // EXEC, tw5D(deltap,no,name);
  // where:
  // deltap = inital momentum offset
  // no = order of computation
  // name = nametag for the output table (f.i. an error seed)

// -------------------------------------------------------------------- 
// tw4D(): run ptc_twiss.
  
  // Closed orbit will be searched. 
  // usage:
  // EXEC, tw4D(no,name);
  // where:
  // no = order of computation
  // name = nametag for the output table (f.i. an error seed)

// -------------------------------------------------------------------- 

// sP6D(): Track single particle. Tracking with radiation effects (damping + quantum excitation).
  
  // Closed orbit will be searched. 
  // usage:
  // EXEC, sP6D(maxturns, x0, px0, y0, py0, t0, pt0, name);
  // where:
  // maxturns = maximum number of turns to track
  // x0, px0, y0, py0, t0, pt0 = initial coordinates of particle
  // name = nametag for the output table (f.i. an error seed)

// -------------------------------------------------------------------- 

// sP6Dnr(): Track single particle. Tracking without radiation effects.
  
  // Closed orbit will be searched. 
  // usage:
  // EXEC, sP6Dnr(maxturns, x0, px0, y0, py0, t0, pt0, name);
  // where:
  // maxturns = maximum number of turns to track
  // x0, px0, y0, py0, t0, pt0 = initial coordinates of particle
  // name = nametag for the output table (f.i. an error seed)

// -------------------------------------------------------------------- 
// sP5D(): Track single particle with momentum deviation.
  
  // Closed orbit will be searched. 
  // usage:
  // EXEC, sP5D(maxturns, x0, px0, y0, py0, t0, pt0, name);
  // where:
  // maxturns = maximum number of turns to track
  // x0, px0, y0, py0, t0, pt0 = initial coordinates of particle
  // name = nametag for the output table (f.i. an error seed)

// -------------------------------------------------------------------- 
// sP4D(): Track single particle.
  
  // Closed orbit will be searched. 
  // usage:
  // EXEC, sP4D(maxturns, x0, px0, y0, py0, t0, pt0, name);
  // where:
  // maxturns = maximum number of turns to track
  // x0, px0, y0, py0, t0, pt0 = initial coordinates of particle
  // name = nametag for the output table (f.i. an error seed)

// -------------------------------------------------------------------- 

// da6D(): efficient tracking of dynamic aperture. Useful for tracking many seeds. First a coarse scan is performed, then a fine scan depending on the outcome of the coarse scan. Tracking with radiation effects (damping + quantum excitation).
  
  // creates table da and writes table dynapname.txt. Tracking is done in full 6D including quantum excitation and radiation damping. Sequence must be loaded in advance! Closed orbit will be searched. 
  // usage:
  // EXEC, da6D(maxturns, rmin, rmax, phimin, phimax, rsteps, phisteps, ratioxy, name);
  // where:
  // maxturns = maximum number of turns to track
  // rmin = minimum radius to start tracking (f.i. 0.0)
  // rmax = maximum radius to track (f.i. 3.0E-2)
  // phimin = minimum angle in terms of pi (f.i. 0.0)
  // phimax = maximum angle in terms of pi (f.i. 1.0)
  // rsteps = number of steps in r (f.i. 20) (N.B. this value is also used for the fine scan!)
  // phisteps = number of steps in phi (f.i. 21)
  // ratioxy = ratio of how r and phi are translated to x / y. y = ratioxy * x. 
  // name = nametag for the output table (f.i. an error seed)
   
// -------------------------------------------------------------------- 

// sda6D(): slow tracking of dynamic aperture on grid. Tracking with radiation effects (damping + quantum excitation).
  
  // creates tracking table for further analysis. Tracking is done in full 6D including quantum excitation and radiation damping. Sequence must be loaded in advance! Closed orbit will be searched. 
  // usage:
  // EXEC, sda6D(maxturns, xmin, xmax, ymin, ymax, xsteps, ysteps, name);
  // where:
  // maxturns = maximum number of turns to track
  // xmin = minimum hor. amplitude to start tracking (f.i. 0.0)
  // xmax = maximum hor. amplitude to track (f.i. 3.0E-2)
  // ymin = minimum ver. amplitude to start tracking (f.i. 0.0)
  // ymax = maximum ver. amplitude to track (f.i. 3.0E-2)
  // xsteps = number of steps in r (f.i. 20) (N.B. this value is also used for the fine scan!)
  // ysteps = number of steps in phi (f.i. 21)
  // name = nametag for the output table (f.i. an error seed)
   
// --------------------------------------------------------------------

// da6Dnr(): efficient tracking of dynamic aperture. Useful for tracking many seeds. First a coarse scan is performed, then a fine scan depending on the outcome of the coarse scan. Tracking without radiation effects.
  
  // creates table da and writes table dynapname.txt. Tracking is done in 6D without quantum excitation and without radiation damping. Sequence must be loaded in advance! Closed orbit will be searched. 
  // usage:
  // EXEC, da6Dnr(maxturns, rmin, rmax, phimin, phimax, rsteps, phisteps, ratioxy, name);
  // where:
  // maxturns = maximum number of turns to track
  // rmin = minimum radius to start tracking (f.i. 0.0)
  // rmax = maximum radius to track (f.i. 3.0E-2)
  // phimin = minimum angle in terms of pi (f.i. 0.0)
  // phimax = maximum angle in terms of pi (f.i. 1.0)
  // rsteps = number of steps in r (f.i. 20) (N.B. this value is also used for the fine scan!)
  // phisteps = number of steps in phi (f.i. 21)
  // ratioxy = ratio of how r and phi are translated to x / y. y = ratioxy * x. 
  // name = nametag for the output table (f.i. an error seed)
   
// --------------------------------------------------------------------
// mafma(maxturns, sigx, nx, deltamin, deltamax, steps, ind0, ind1, jnd0, jnd1, name) : macro {


// dafma(): tracking is performed without radiation damping to use data for frequency map analysis. Initial particle coordinates are scaled with sqrt-scaling in order to alter tune (depending on Action^2) linearly! This one is suited for splitting since it takes ind0 ind1 as arguments for the indices. 

  // usage:
  // EXEC, dafma(maxturns, sigx, sigy, nx, ny, steps, ind0, ind1, jnd0, jnd1, name);
  // where:
  // maxturns = number of turns to track
  // sigx = horizontal beam size
  // sigy = vertical beam size
  // nx = maximum number of horizontal beamsizes for horizontal amplitude
  // ny = maximum number of vertical beamsizes for vertical amplitude
  // steps = number of steps between zero and hor. / vert. number of beamsizes
  // ind0 = used for splitting the jobs, if splitted: ind0 is starting index for outer loop; if not splitted: ind0 must be 0
  // ind1 = used for splitting the jobs, if splitted: ind1 is end (inclusive) index for outer loop; if not splitted: ind1 must be steps
  // jnd0 = used for splitting the jobs, if splitted: jnd0 is starting index for inner loop; if not splitted: jnd0 must be 0
  // jnd1 = used for splitting the jobs, if splitted: jnd1 is end (inclusive) index for inner loop; if not splitted: jnd1 must be steps
  // name = nametag for output file: nameone

// --------------------------------------------------------------------

// da4D(): efficient tracking of 4D dynamic aperture, so tracking without radiation or cavity.
  
  // creates table da and writes table dynapname.txt. Tracking is done in 4D. Sequence must be loaded in advance! Closed orbit will be searched. 
  // usage:
  // EXEC, da4D(maxturns, rmin, rmax, phimin, phimax, rsteps, phisteps, ratioxy, name);
  // where:
  // maxturns = maximum number of turns to track
  // rmin = minimum radius to start tracking (f.i. 0.0)
  // rmax = maximum radius to track (f.i. 3.0E-2)
  // phimin = minimum angle in terms of pi (f.i. 0.0)
  // phimax = maximum angle in terms of pi (f.i. 1.0)
  // rsteps = number of steps in r (f.i. 20) (N.B. this value is also used for the fine scan!)
  // phisteps = number of steps in phi (f.i. 21)
  // ratioxy = ratio of how r and phi are translated to x / y. y = ratioxy * x. 
  // name = nametag for the output table (f.i. an error seed)

// --------------------------------------------------------------------

// ma5D(): efficient tracking of 5D momentum aperture (x/delta). Tracking without radiation or cavity. 

// creates table da and writes table ma_name.txt. Closed orbit will be searched and used. 

// usage:
// EXEC, ma5D(maxturns, xmin, xmax, stepsx, deltamin, deltamax, stepsd, name);
// where:
// maxturns = maximum number of turns to track
// xmin = minimum horizontal amplitude
// xmax = maximum horizontal amplitude
// stepsx = number of steps between xmin and xmax
// deltamin = minimum energy offset
// deltamax = maximum energy offset
// stepsd = steps between deltamin and deltamax
// name = nametag for the output table 

// wmacro: not particularly interesting... used for tracking to access intermediate tables
  
    // macro for accessing tables with variables... should not be necessary, but is.
    // usage: 
    // EXEC, wmacro(table,variable,$index);
  		   
// --------------------------------------------------------------------
PRINT, text=' ************************************************************************ ';
PRINT, text=' ';
PRINT, text='          ____ _____ ____   _                  _    _             ';
PRINT, text='         |  _ \_   _/ ___| | |_ _ __ __ _  ___| | _(_)_ __   __ _ ';
PRINT, text='         | |_) || || |     | __| "__/ _` |/ __| |/ / | "_ \ / _` |';
PRINT, text='         |  __/ | || |___  | |_| | | (_| | (__|   <| | | | | (_| |';
PRINT, text='         |_|    |_| \____|  \__|_|  \__,_|\___|_|\_\_|_| |_|\__, |';
PRINT, text='                                                            |___/ ';
PRINT, text='                        __  __                          ';
PRINT, text='                       |  \/  | __ _  ___ _ __ ___  ___ ';
PRINT, text='                       | |\/| |/ _` |/ __| "__/ _ \/ __|';
PRINT, text='                       | |  | | (_| | (__| | | (_) \__ \ ';
PRINT, text='                       |_|  |_|\__,_|\___|_|  \___/|___/';
PRINT, text=' ';
PRINT, text=' ************************************************************************ ';
PRINT, text=' ';
PRINT, text=' -> a set of macros for tracking dynamic and momentum aperture in MADX-PTC';
PRINT, text=' ';
PRINT, text=' *************************************';
PRINT, text=' * Feb 2018, ttydecks CERN BE-OP-LHC *';
PRINT, text=' *************************************';
PRINT, text=' ';
PRINT, text=' ** ALWAYS BE AWARE THAT WHEN CALLING MACROS WITH NEGATIVE NUMBERS THEY FAIL!!! ***';
PRINT, text=' --> WORKAROUND:';
PRINT, text='     foo = -5.0;';
PRINT, text='     bar = -2.0;';
PRINT, text='     EXEC, somemacro(foo, bar);';
PRINT, text=' ';
PRINT, text=' ------------------------------------------------------------------------- ';
PRINT, text=' CONTENT:';
PRINT, text='    * helpTM   <---> EXEC, helpTM;   <-- this will display documentation';
PRINT, text='    * manglePTC';
PRINT, text='    * sP6D';
PRINT, text='    * sP6Dnr';
PRINT, text='    * sP5D';
PRINT, text='    * sP4D';
PRINT, text='    * da6D';
PRINT, text='    * da6Dnr';
PRINT, text='    * dafma';
PRINT, text='    * da4D';
PRINT, text='    * ma5D';
PRINT, text='    * mafma';
PRINT, text='    * ma6D';
PRINT, text='    * ma6Dnr';
PRINT, text='    * sda6D';
PRINT, text='    * tw6D';
PRINT, text='    * tw6Dnr';
PRINT, text='    * tw5D';
PRINT, text='    * tw4D';
PRINT, text='    * wmacro';
PRINT, text=' ';
PRINT, text=' ------------------------------------------------------------------------- ';

ptcmodel = 2;
ptcmethod = 2;
ptcsplit = 0.001;

helpTM : macro {
  PRINT, text=' -------------------------------------------------------------------- ';
  PRINT, text=' helpTM(): display documentation.';
  PRINT, text=' usage:';
  PRINT, text=' EXEC, helTM;';
  PRINT, text=' -------------------------------------------------------------------- ';
  PRINT, text=' manglePTC(): change PTC default switches. Expert use!! ';
  PRINT, text=' changes the default ptc layout settings. The default values for parameters are:';
  PRINT, text=' PTC_CREATE_LAYOUT, MODEL=3,NST=3,METHOD=6,CLOSED_LAYOUT=true;';
  PRINT, text=' usage:';
  PRINT, text=' EXEC, manglePTC(newmodel, newsplit, newmethod);';
  PRINT, text=' newmodel = new model to use (1, 2, or 3) (default 2)';
  PRINT, text=' newsplit = set the splitting parameter depending on strength of magnet (default 0.001)';
  PRINT, text=' newmethod = new method for integration to use (2, 4, or 6) (default 2)';
  PRINT, text=' -------------------------------------------------------------------- ';
  PRINT, text=' sP6D(): Track single particle. Tracking with radiation effects (damping + quantum excitation).';  
  PRINT, text=' Closed orbit will be searched. ';
  PRINT, text=' usage:';
  PRINT, text=' EXEC, sP6D(maxturns, x0, px0, y0, py0, t0, pt0, name);';
  PRINT, text=' where:';
  PRINT, text=' maxturns = maximum number of turns to track';
  PRINT, text=' x0/px0/y0/py0/t0/pt0 = initial coordinates';
  PRINT, text=' name = nametag for the output table (f.i. an error seed)';
  PRINT, text=' -------------------------------------------------------------------- ';
  PRINT, text=' sP6Dnr(): Track single particle. Tracking without radiation effects.';
  PRINT, text=' Closed orbit will be searched. ';
  PRINT, text=' usage:';
  PRINT, text=' EXEC, sP6Dnr(maxturns, x0, px0, y0, py0, t0, pt0, name);';
  PRINT, text=' where:';
  PRINT, text=' maxturns = maximum number of turns to track';
  PRINT, text=' x0/px0/y0/py0/t0/pt0 = initial coordinates';
  PRINT, text=' name = nametag for the output table (f.i. an error seed)';
  PRINT, text=' -------------------------------------------------------------------- ';
  PRINT, text=' sP5D(): Track single particle with momentum deviation.';
  PRINT, text=' Closed orbit will be searched. ';
  PRINT, text=' usage:';
  PRINT, text=' EXEC, sP5D(maxturns, x0, px0, y0, py0, t0, pt0, name);';
  PRINT, text=' where:';
  PRINT, text=' maxturns = maximum number of turns to track';
  PRINT, text=' x0/px0/y0/py0/t0/pt0 = initial coordinates';
  PRINT, text=' name = nametag for the output table (f.i. an error seed)';
  PRINT, text=' -------------------------------------------------------------------- ';
  PRINT, text=' sP4D(): Track single particle.';
  PRINT, text=' Closed orbit will be searched. ';
  PRINT, text=' usage:';
  PRINT, text=' EXEC, sP4D(maxturns, x0, px0, y0, py0, t0, pt0, name);';
  PRINT, text=' where:';
  PRINT, text=' maxturns = maximum number of turns to track';
  PRINT, text=' x0/px0/y0/py0/t0/pt0 = initial coordinates';
  PRINT, text=' name = nametag for the output table (f.i. an error seed)';
  PRINT, text=' -------------------------------------------------------------------- ';
  PRINT, text=' da6D(): efficient tracking of dynamic aperture. Useful for tracking many seeds. First a coarse scan is performed, then a fine scan depending on the outcome of the coarse scan. Tracking with radiation effects (damping + quantum excitation).';
  PRINT, text=' creates table da and writes table dynapname.txt. Tracking is done in full 6D including quantum excitation and radiation damping. Sequence must be loaded in advance! Closed orbit will be searched. ';
  PRINT, text=' usage:';
  PRINT, text=' EXEC, da6D(maxturns, rmin, rmax, phimin, phimax, rsteps, phisteps, ratioxy, name);';
  PRINT, text=' where:';
  PRINT, text=' maxturns = maximum number of turns to track';
  PRINT, text=' rmin = minimum radius to start tracking (f.i. 0.0)';
  PRINT, text=' rmax = maximum radius to track (f.i. 3.0E-2)';
  PRINT, text=' phimin = minimum angle in terms of pi (f.i. 0.0)';
  PRINT, text=' phimax = maximum angle in terms of pi (f.i. 1.0)';
  PRINT, text=' rsteps = number of steps in r (f.i. 20) (N.B. this value is also used for the fine scan!)';
  PRINT, text=' phisteps = number of steps in phi (f.i. 21)';
  PRINT, text=' ratioxy = ratio of how r and phi are translated to x / y. y = ratioxy * x. ';
  PRINT, text=' name = nametag for the output table (f.i. an error seed)';
  PRINT, text=' --------------------------------------------------------------------';
  PRINT, text=' da6Dnr(): efficient tracking of dynamic aperture. Useful for tracking many seeds. First a coarse scan is performed, then a fine scan depending on the outcome of the coarse scan. Tracking without radiation effects.';
  PRINT, text=' creates table da and writes table dynapname.txt. Tracking is done in 6D without quantum excitation and without radiation damping. Sequence must be loaded in advance! Closed orbit will be searched. ';
  PRINT, text=' usage:';
  PRINT, text=' EXEC, da6Dnr(maxturns, rmin, rmax, phimin, phimax, rsteps, phisteps, ratioxy, name);';
  PRINT, text=' where:';
  PRINT, text=' maxturns = maximum number of turns to track';
  PRINT, text=' rmin = minimum radius to start tracking (f.i. 0.0)';
  PRINT, text=' rmax = maximum radius to track (f.i. 3.0E-2)';
  PRINT, text=' phimin = minimum angle in terms of pi (f.i. 0.0)';
  PRINT, text=' phimax = maximum angle in terms of pi (f.i. 1.0)';
  PRINT, text=' rsteps = number of steps in r (f.i. 20) (N.B. this value is also used for the fine scan!)';
  PRINT, text=' phisteps = number of steps in phi (f.i. 21)';
  PRINT, text=' ratioxy = ratio of how r and phi are translated to x / y. y = ratioxy * x. ';
  PRINT, text=' name = nametag for the output table (f.i. an error seed)';
  PRINT, text=' --------------------------------------------------------------------';
  PRINT, text=' dafma(): tracking is performed without radiation damping to use data for frequency map analysis. Initial particle coordinates are scaled with sqrt-scaling in order to alter tune (depending on Action^2) linearly! This one is suited for splitting since it takes ind0 ind1 as arguments for the indices. ';
  PRINT, text=' usage:';
  PRINT, text=' EXEC, dafma(maxturns, sigx, sigy, nx, ny, steps, ind0, ind1, jnd0, jnd1, name);';
  PRINT, text=' where:';
  PRINT, text=' maxturns = number of turns to track';
  PRINT, text=' sigx = horizontal beam size';
  PRINT, text=' sigy = vertical beam size';
  PRINT, text=' nx = maximum number of horizontal beamsizes for horizontal amplitude';
  PRINT, text=' ny = maximum number of vertical beamsizes for vertical amplitude';
  PRINT, text=' steps = number of steps between zero and hor. / vert. number of beamsizes';
  PRINT, text=' ind0 = used for splitting the jobs, if splitted: ind0 is starting index for outer loop; if not splitted: ind0 must be 0';
  PRINT, text=' ind1 = used for splitting the jobs, if splitted: ind1 is end (inclusive) index for outer loop; if not splitted: ind1 must be steps';
  PRINT, text=' jnd0 = used for splitting the jobs, if splitted: jnd0 is starting index for inner loop; if not splitted: jnd0 must be 0';
  PRINT, text=' jnd1 = used for splitting the jobs, if splitted: jnd1 is end (inclusive) index for inner loop; if not splitted: jnd1 must be steps';
  PRINT, text=' name = nametag for output file: nameone';
  PRINT, text=' --------------------------------------------------------------------';
  PRINT, text=' da4D(): efficient tracking of 4D dynamic aperture, so tracking without radiation or cavity.';
  PRINT, text=' creates table da and writes table dynapname.txt. Tracking is done in 4D. Sequence must be loaded in advance! Closed orbit will be searched. ';
  PRINT, text=' usage:';
  PRINT, text=' EXEC, da4D(maxturns, rmin, rmax, phimin, phimax, rsteps, phisteps, ratioxy, name);';
  PRINT, text=' where:';
  PRINT, text=' maxturns = maximum number of turns to track';
  PRINT, text=' rmin = minimum radius to start tracking (f.i. 0.0)';
  PRINT, text=' rmax = maximum radius to track (f.i. 3.0E-2)';
  PRINT, text=' phimin = minimum angle in terms of pi (f.i. 0.0)';
  PRINT, text=' phimax = maximum angle in terms of pi (f.i. 1.0)';
  PRINT, text=' rsteps = number of steps in r (f.i. 20) (N.B. this value is also used for the fine scan!)';
  PRINT, text=' phisteps = number of steps in phi (f.i. 21)';
  PRINT, text=' ratioxy = ratio of how r and phi are translated to x / y. y = ratioxy * x. ';
  PRINT, text=' name = nametag for the output table (f.i. an error seed)';
  PRINT, text=' --------------------------------------------------------------------';
  PRINT, text=' ma5D(): efficient tracking of 5D momentum aperture (x/delta). Tracking without radiation or cavity. ';
  PRINT, text=' creates table da and writes table ma_name.txt. Closed orbit will be searched and used. ';
  PRINT, text=' usage:';
  PRINT, text=' EXEC, ma5D(maxturns, xmin, xmax, stepsx, deltamin, deltamax, stepsd, name);';
  PRINT, text=' where:';
  PRINT, text=' maxturns = maximum number of turns to track';
  PRINT, text=' xmin = minimum horizontal amplitude';
  PRINT, text=' xmax = maximum horizontal amplitude';
  PRINT, text=' stepsx = number of steps between xmin and xmax';
  PRINT, text=' deltamin = minimum energy offset';
  PRINT, text=' deltamax = maximum energy offset';
  PRINT, text=' stepsd = steps between deltamin and deltamax';
  PRINT, text=' name = nametag for the output table ';
  PRINT, text=' --------------------------------------------------------------------';
  PRINT, text=' mafma(): tracking is performed without radiation damping to use data for frequency map analysis. This one is suited for splitting since it takes ind0 ind1 as arguments for the indices. ';
  PRINT, text=' usage:';
  PRINT, text=' EXEC, mafma(maxturns, sigx, nx, deltamin, deltamax steps, ind0, ind1, jnd0, jnd1, name);';
  PRINT, text=' where:';
  PRINT, text=' maxturns = number of turns to track';
  PRINT, text=' sigx = horizontal beam size';
  PRINT, text=' nx = maximum number of horizontal beamsizes for horizontal amplitude';
  PRINT, text='deltamin = minimum energy deviation';
  PRINT, text='deltamax = maximum energy deviation';
  PRINT, text=' steps = number of steps between zero and hor. number of beamsizes / energy deviations';
  PRINT, text=' ind0 = used for splitting the jobs, if splitted: ind0 is starting index for outer loop; if not splitted: ind0 must be 0';
  PRINT, text=' ind1 = used for splitting the jobs, if splitted: ind1 is end (inclusive) index for outer loop; if not splitted: ind1 must be steps';
  PRINT, text=' jnd0 = used for splitting the jobs, if splitted: jnd0 is starting index for inner loop; if not splitted: jnd0 must be 0';
  PRINT, text=' jnd1 = used for splitting the jobs, if splitted: jnd1 is end (inclusive) index for inner loop; if not splitted: jnd1 must be steps';
  PRINT, text=' name = nametag for output file: nameone';
  PRINT, text=' --------------------------------------------------------------------';
  PRINT, text=' ma6D(): efficient tracking of 6D momentum aperture (x/delta). Tracking with radiation and quantum excitation. ';
  PRINT, text=' creates table da and writes table ma_name.txt. Closed orbit will be searched and used. ';
  PRINT, text=' usage:';
  PRINT, text=' EXEC, ma6D(maxturns, xmin, xmax, stepsx, deltamin, deltamax, stepsd, name);';
  PRINT, text=' where:';
  PRINT, text=' maxturns = maximum number of turns to track';
  PRINT, text=' xmin = minimum horizontal amplitude';
  PRINT, text=' xmax = maximum horizontal amplitude';
  PRINT, text=' stepsx = number of steps between xmin and xmax';
  PRINT, text=' deltamin = minimum energy offset';
  PRINT, text=' deltamax = maximum energy offset';
  PRINT, text=' stepsd = steps between deltamin and deltamax';
  PRINT, text=' name = nametag for the output table ';
  PRINT, text=' --------------------------------------------------------------------';
  PRINT, text=' ma6Dnr(): efficient tracking of 6D momentum aperture (x/delta). Tracking without radiation. ';
  PRINT, text=' creates table da and writes table ma_name.txt. Closed orbit will be searched and used. ';
  PRINT, text=' usage:';
  PRINT, text=' EXEC, ma6Dnr(maxturns, xmin, xmax, stepsx, deltamin, deltamax, stepsd, name);';
  PRINT, text=' where:';
  PRINT, text=' maxturns = maximum number of turns to track';
  PRINT, text=' xmin = minimum horizontal amplitude';
  PRINT, text=' xmax = maximum horizontal amplitude';
  PRINT, text=' stepsx = number of steps between xmin and xmax';
  PRINT, text=' deltamin = minimum energy offset';
  PRINT, text=' deltamax = maximum energy offset';
  PRINT, text=' stepsd = steps between deltamin and deltamax';
  PRINT, text=' name = nametag for the output table ';
  PRINT, text=' --------------------------------------------------------------------';
  PRINT, text=' sda6D(): slow tracking of dynamic aperture on grid. Tracking with radiation effects (damping + quantum excitation).';
  PRINT, text=' creates tracking table for further analysis. Tracking is done in full 6D including quantum excitation and radiation damping. Sequence must be loaded in advance! Closed orbit will be searched. ';
  PRINT, text=' usage:';
  PRINT, text=' EXEC, sda6D(maxturns, xmin, xmax, ymin, ymax, xsteps, ysteps, name);';
  PRINT, text=' where:';
  PRINT, text=' maxturns = maximum number of turns to track';
  PRINT, text=' xmin = minimum hor. amplitude to start tracking (f.i. 0.0)';
  PRINT, text=' xmax = maximum hor. amplitude to track (f.i. 3.0E-2)';
  PRINT, text=' ymin = minimum ver. amplitude to start tracking (f.i. 0.0)';
  PRINT, text=' ymax = maximum ver. amplitude to track (f.i. 3.0E-2)';
  PRINT, text=' xsteps = number of steps in r (f.i. 20) (N.B. this value is also used for the fine scan!)';
  PRINT, text=' ysteps = number of steps in phi (f.i. 21)';
  PRINT, text=' name = nametag for the output table (f.i. an error seed)';
  PRINT, text=' --------------------------------------------------------------------';
  PRINT, text=' tw6D(): run ptc_twiss incl. radiation effects (damping + quantum excitation).';
  PRINT, text=' Closed orbit will be searched. ';
  PRINT, text=' usage:';
  PRINT, text=' EXEC, tw6D(no, name);';
  PRINT, text=' where:';
  PRINT, text=' no = order of computation (f.i. 2)';
  PRINT, text=' name = nametag for the output table (f.i. an error seed)';
  PRINT, text=' -------------------------------------------------------------------- ';
  PRINT, text=' tw6Dnr(): run ptc_twiss excl. radiation effects.';
  PRINT, text=' Closed orbit will be searched. ';
  PRINT, text=' usage:';
  PRINT, text=' EXEC, tw6Dnr(no, name);';
  PRINT, text=' where:';
  PRINT, text=' no = order of computation (f.i. 2)';
  PRINT, text=' name = nametag for the output table (f.i. an error seed)';
  PRINT, text=' -------------------------------------------------------------------- ';
  PRINT, text=' tw5D(): run ptc_twiss with momentum offset.';
  PRINT, text=' Closed orbit will be searched. ';
  PRINT, text=' usage:';
  PRINT, text=' EXEC, tw5D(deltap, no, name);';
  PRINT, text=' where:';
  PRINT, text=' deltap = momentum deviation';
  PRINT, text=' no = order of computation (f.i. 2)';
  PRINT, text=' name = nametag for the output table (f.i. an error seed)';
  PRINT, text=' -------------------------------------------------------------------- ';
  PRINT, text=' tw4D(): run ptc_twiss.';
  PRINT, text=' Closed orbit will be searched. ';
  PRINT, text=' usage:';
  PRINT, text=' EXEC, tw4D(no, name);';
  PRINT, text=' where:';
  PRINT, text=' no = order of computation (f.i. 2)';
  PRINT, text=' name = nametag for the output table (f.i. an error seed)';
  PRINT, text=' -------------------------------------------------------------------- ';
  PRINT, text=' wmacro: not particularly interesting... used for tracking to access intermediate tables';
  PRINT, text=' macro for accessing tables with variables... should not be necessary, but is.';
  PRINT, text=' usage: ';
  PRINT, text=' EXEC, wmacro(table,variable,$index);';
  PRINT, text=' --------------------------------------------------------------------';
}

manglePTC(newmodel, newsplit, newmethod) : macro {
  IF (newmodel > 0 && newmodel < 4) {
    PRINTf, text=' ptc model set to %g', value=newmodel;
    ptcmodel = newmodel;
  }
  IF (newsplit > 0) {
    PRINTf, text=' ptc nst set to %g', value=newsplit;
    ptcsplit = newsplit;    
  }
  IF ((newmethod == 2 || newmethod == 4) || newmethod == 6) {
    PRINTf, text=' ptc method set to %g', value=newmethod;
    ptcmethod = newmethod;    
  }
}

wmacro(stable, var, no) : macro {
  val = table(stable, var, no);
}

tw5D(deltaptw5D, notw5D, nntw5D) : macro {
  PTC_CREATE_UNIVERSE;
    PTC_CREATE_LAYOUT, MODEL=ptcmodel,NST=1,METHOD=ptcmethod,EXACT=true,RESPLIT,THIN=ptcsplit,XBEND=ptcsplit;
    PTC_ALIGN;
    PTC_SETSWITCH, debuglevel=1,maxacceleration=false,exact_mis=true,time=true,totalpath=false,fringe=true,radiation=false,stochastic=false,envelope=false;
    PTC_TWISS, ICASE=5, CLOSED_ORBIT, DELTAP = deltaptw5D, NO=notw5D, RMATRIX, FILE=ptc_twiss_nntw5D.out;
  PTC_END;
}

tw6Dnr(notw6Dnr, nntw6Dnr) : macro {
  PTC_CREATE_UNIVERSE;
    PTC_CREATE_LAYOUT, MODEL=ptcmodel,NST=1,METHOD=ptcmethod,EXACT=true,RESPLIT,THIN=ptcsplit,XBEND=ptcsplit;
    PTC_ALIGN;
    PTC_SETSWITCH, debuglevel=1,maxacceleration=false,exact_mis=true,time=true,totalpath=false,fringe=true,radiation=false,stochastic=false,envelope=false;
    PTC_TWISS, ICASE=6, CLOSED_ORBIT, NO=notw6Dnr, RMATRIX, FILE=ptc_twiss_nntw6Dnr.out;
  PTC_END;
}

tw4D(notw4D, nntw4D) : macro {
  PTC_CREATE_UNIVERSE;
    PTC_CREATE_LAYOUT, MODEL=ptcmodel,NST=1,METHOD=ptcmethod,EXACT=true,RESPLIT,THIN=ptcsplit,XBEND=ptcsplit;
    PTC_ALIGN;
    PTC_SETSWITCH, debuglevel=1,maxacceleration=false,exact_mis=true,time=true,totalpath=false,fringe=true,radiation=false,stochastic=false,envelope=false;
    PTC_TWISS, ICASE=4, CLOSED_ORBIT, NO=notw4D, RMATRIX, FILE=ptc_twiss_nntw4D.out;
  PTC_END;
}

tw6D(notw6D, nntw6D) : macro {
  PTC_CREATE_UNIVERSE;
    PTC_CREATE_LAYOUT, MODEL=ptcmodel,NST=1,METHOD=ptcmethod,EXACT=true,RESPLIT,THIN=ptcsplit,XBEND=ptcsplit;
    PTC_ALIGN;
    PTC_SETSWITCH, debuglevel=1,maxacceleration=false,exact_mis=true,time=true,totalpath=false,fringe=true,radiation=true,stochastic=true,envelope=true;
    PTC_TWISS, ICASE=6, CLOSED_ORBIT, NO=notw6D, RMATRIX, FILE=ptc_twiss_nntw6D.out;
  PTC_END;
}

ma5D(ntma5D, xima5D, xama5D, nxma5D, dima5D, dama5D, ndma5D, nnma5D) : macro {
  CREATE, table=dac, column=xsurv,dsurv;
  CREATE, table=da, column=X0surv, d0surv;
  // first coarse scan:
  xsurv = 0;
  dsurv = 0;

  X0 := xima5D + abs(i) * (xama5D-xima5D)/nxma5D;
  delta := dima5D + abs(j) * (dama5D-dima5D)/ndma5D;

  j = 0;
  while (j < ndma5D+1) {	

    PTC_CREATE_UNIVERSE;
      PTC_CREATE_LAYOUT, MODEL=ptcmodel,NST=1,METHOD=ptcmethod,EXACT=true,RESPLIT,THIN=ptcsplit,XBEND=ptcsplit;
      PTC_ALIGN;
      PTC_SETSWITCH, debuglevel=1,maxacceleration=false,exact_mis=true,time=true,totalpath=false,fringe=true,radiation=false,stochastic=false,envelope=false;
      i = 1;
      while (i < nxma5D+1) {
	PTC_START, X=X0, PX=0.0, Y=0.0, PY=0.0, T=0.0, PT=delta;
	i = i + 1;
      }
      PRINT, text="******/////////******";
      PRINTF, text="coarse scan: %g/%g", value=j, ndma5D;
      PRINT, text="******/////////******";
      PTC_TRACK, ICASE=5, CLOSED_ORBIT, TURNS=ntma5D;
      PTC_TRACK_END;
 
      k = nxma5D + 1;
      while(k < 2*nxma5D+1) {
	EXEC, wmacro(tracksumm,turn,$k);
	if (val == ntma5D) {
	  xsurv = xima5D + (xama5D-xima5D)/nxma5D * (k-nxma5D);
	}   
	if (val <> ntma5D) {
	  k = 2 * nxma5D;
	}
	k = k + 1;
      }
    PTC_END;
 
    dsurv = delta;
    FILL, table=dac;
    j = j + 1;
  }

  WRITE, table=dac;

  PRINT, text="doing fine scan now...";

  xmino = xima5D;
  xostep = (xama5D-xima5D)/nxma5D;

  j = 0;
  while (j < ndma5D+1) {	
    k = j + 1;
    EXEC, wmacro(dac,XSURV,$k);
    xima5D = val;
    xama5D = xima5D + xostep;
  
    X0 := xima5D + abs(i) * (xama5D-xima5D)/nxma5D;
    delta := dima5D + abs(j) * (dama5D-dima5D)/ndma5D;

    PTC_CREATE_UNIVERSE;
      PTC_CREATE_LAYOUT, MODEL=ptcmodel,NST=1,METHOD=ptcmethod,EXACT=true,RESPLIT,THIN=ptcsplit,XBEND=ptcsplit;
      PTC_ALIGN;
      PTC_SETSWITCH, debuglevel=1,maxacceleration=false,exact_mis=true,time=true,totalpath=false,fringe=true,radiation=false,stochastic=false,envelope=false;
      i = 1;
      while (i < nxma5D+1) {
	PTC_START, X=X0, PX=0.0, Y=0.0, PY=0.0, T=0.0, PT=delta;
	i = i + 1;
      }
      PRINT, text="******/////////******";
      PRINTF, text="coarse scan: %g/%g", value=j, ndma5D;
      PRINT, text="******/////////******";
      PTC_TRACK, ICASE=5, CLOSED_ORBIT, TURNS=ntma5D;
      PTC_TRACK_END;
 
      k = nxma5D + 1;
      while(k < 2*nxma5D+1) {
	EXEC, wmacro(tracksumm,turn,$k);
	if (val == ntma5D) {
	  xsurv = xima5D + (xama5D-xima5D)/nxma5D * (k-nxma5D);
	}
	if (val <> ntma5D) {
	  k = 2 * nxma5D;
	}    
	k = k + 1;
      }
 
      X0surv = xsurv;
      d0surv = delta;

    PTC_END;

    FILL, table=da;
  
    j = j + 1;
  }

  WRITE, table=dac;
  WRITE, table=da;
  WRITE, table=da, file=ma_nnma5D.txt;

}

ma6D(ntma6D, xima6D, xama6D, nxma6D, dima6D, dama6D, ndma6D, nnma6D) : macro {
  CREATE, table=mac, column=dsurv,xsurv;
  CREATE, table=ma, column=d0surv, x0surv;
  // first coarse scan:
  xsurv = 0;
  dsurv = 0;

  X0 := xima6D + abs(i) * (xama6D-xima6D)/(nxma6D-1);
  delta := dima6D + abs(j) * (dama6D-dima6D)/(ndma6D-1);

  PTC_CREATE_UNIVERSE;
    PTC_CREATE_LAYOUT, MODEL=ptcmodel,NST=1,METHOD=ptcmethod,EXACT=true,RESPLIT,THIN=ptcsplit,XBEND=ptcsplit;
    PTC_ALIGN;
    PTC_SETSWITCH, debuglevel=1,maxacceleration=false,exact_mis=true,time=false,totalpath=false,fringe=true,radiation=true,stochastic=true,envelope=true, seed=1;
    PTC_TWISS, ICASE=6, CLOSED_ORBIT, NO=2, RMATRIX;

    j = 0;
    while (j < ndma6D) {	

      i = 0;
      while (i < nxma6D) {
	PTC_START, X=X0, PX=0.0, Y=0.0, PY=0.0, T=0.0, PT=delta;
	i = i + 1;
      }
      j = j + 1;
    }
    PTC_TRACK, ICASE=6, CLOSED_ORBIT, RADIATION,TURNS=ntma6D;
    PTC_TRACK_END;
  PTC_END;

  j = 0;
  while (j < ndma6D) {
    xsurv = 0.0;
    kmin = ndma6D * nxma6D + j * nxma6D + 1;
    kmax = ndma6D * nxma6D + (j+1) * nxma6D + 1;
    k  = kmin;
    while(k < kmax) {
      EXEC, wmacro(tracksumm,turn,$k);
      if (val == ntma6D) {
	xsurv = xima6D + (xama6D-xima6D)/(nxma6D-1) * (k-kmin);
      }   
      if (val <> ntma6D) {
	k = kmax;
      }   
      k = k + 1;
    }
 
    dsurv = delta;
    FILL, table=mac;
    j = j + 1;
  }

  WRITE, table=mac;

  PRINT, text="doing fine scan now...";

  xmino = xima6D;
  xostep = (xama6D-xima6D)/(nxma6D-1);

  PTC_CREATE_UNIVERSE;
    PTC_CREATE_LAYOUT, MODEL=ptcmodel,NST=1,METHOD=ptcmethod,EXACT=true,RESPLIT,THIN=ptcsplit,XBEND=ptcsplit;
    PTC_ALIGN;
    PTC_SETSWITCH, debuglevel=1,maxacceleration=false,exact_mis=true,time=false,totalpath=false,fringe=true,radiation=true,stochastic=true,envelope=true, seed=1;
    PTC_TWISS, ICASE=6, CLOSED_ORBIT, NO=2, RMATRIX;
    j = 0;
    while (j < ndma6D) {	
      k = j + 1;
      EXEC, wmacro(mac,XSURV,$k);
      xima6D = val;
      xama6D = xima6D + xostep;
  
      X0 := xima6D + abs(i) * (xama6D-xima6D)/(nxma6D-1);
      delta := dima6D + abs(j) * (dama6D-dima6D)/(ndma6D-1);

      i = 0;
      while (i < nxma6D) {
	PTC_START, X=X0, PX=0.0, Y=0.0, PY=0.0, T=0.0, PT=delta;
	i = i + 1;
      }
      j = j + 1;
    }
    PTC_TRACK, ICASE=6, CLOSED_ORBIT, RADIATION, TURNS=ntma6D;
    PTC_TRACK_END;
  PTC_END;
 
  j = 0;
  while (j < ndma6D) {

    m = j + 1;
    EXEC, wmacro(mac, XSURV, $m);
    xsurv = val;
    xima6D = val;
    xama6D = xima6D + xostep;
    kmin = ndma6D * nxma6D + j * nxma6D + 1;
    kmax = ndma6D * nxma6D + (j+1) * nxma6D + 1;
    k = kmin;
    while(k < kmax) {
      EXEC, wmacro(tracksumm,turn,$k);
      if (val == ntma6D) {
	xsurv = xima6D + (xama6D-xima6D)/(nxma6D-1) * (k-kmin);
      }
      if (val <> ntma6D) {
	k = kmax;
      }   
      k = k + 1;
    }
 
    x0surv=xsurv;
    d0surv=delta;

    FILL, table=ma;
  
    j = j + 1;
  }

  WRITE, table=mac;
  WRITE, table=ma;
  WRITE, table=ma, file=maper_nnma6D.txt;
}

ma6Dr(ntma6Dr, xima6Dr, xama6Dr, nxma6Dr, dima6Dr, dama6Dr, ndma6Dr, nnma6Dr) : macro {
  CREATE, table=mac, column=dsurv,xsurv;
  CREATE, table=ma, column=d0surv, x0surv;
  // first coarse scan:
  xsurv = 0;
  dsurv = 0;

  X0 := xima6Dr + abs(i) * (xama6Dr-xima6Dr)/(nxma6Dr-1);
