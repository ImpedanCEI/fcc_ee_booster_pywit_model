	i = i + 1;
      }
      j = j + 1;
    }
    PTC_TRACK, ICASE=6, CLOSED_ORBIT, RADIATION,TURNS=ntda6D;
    PTC_TRACK_END;
  PTC_END;

  j = 0;
  while (j < spda6D) {
    kmin = spda6D * srda6D + j * srda6D + 1;
    kmax = spda6D * srda6D + (j+1) * srda6D + 1;
