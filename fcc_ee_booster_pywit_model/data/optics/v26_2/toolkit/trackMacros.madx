  PTC_CREATE_UNIVERSE;
    PTC_CREATE_LAYOUT, MODEL=ptcmodel,NST=1,METHOD=ptcmethod,EXACT=true,RESPLIT,THIN=ptcsplit,XBEND=ptcsplit;
    PTC_ALIGN;
    PTC_SETSWITCH, debuglevel=1,maxacceleration=false,exact_mis=true,time=false,totalpath=false,fringe=true,radiation=true,stochastic=false,envelope=false, seed=1;
    PTC_TWISS, ICASE=6, CLOSED_ORBIT, NO=2, RMATRIX;
    j = 0;
    while (j < ndma6Dr) {	

      i = 0;
      while (i < nxma6Dr) {
	PTC_START, X=X0, PX=0.0, Y=0.0, PY=0.0, T=0.0, PT=delta;
	i = i + 1;
      }
      j = j + 1;
    }
    PTC_TRACK, ICASE=6, CLOSED_ORBIT, RADIATION,TURNS=ntma6Dr;
    PTC_TRACK_END;
  PTC_END;

  j = 0;
  while (j < ndma6Dr) {
    xsurv = 0.0;
    kmin = ndma6Dr * nxma6Dr + j * nxma6Dr + 1;
    kmax = ndma6Dr * nxma6Dr + (j+1) * nxma6Dr + 1;
    k = kmin;
    while(k < kmax) {
      EXEC, wmacro(tracksumm,turn,$k);
      if (val == ntma6Dr) {
	xsurv = xima6Dr + (xama6Dr-xima6Dr)/(nxma6Dr-1) * (k-kmin);
